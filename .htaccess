# Morocco Explorer Tours – Apache/LiteSpeed rules for Hostinger.

ErrorDocument 404 /404.html

# Pages removed by the High Atlas rebrand: send old links and search results to the closest new page.
RedirectMatch 301 ^/destinations/atlas-mountains\.html$ /treks/
RedirectMatch 301 ^/destinations/marrakech\.html$ /excursions/
RedirectMatch 301 ^/destinations(/.*)?$ /
RedirectMatch 301 ^/tours/5-day-atlas-valleys-kasbahs\.html$ /treks/
RedirectMatch 301 ^/tours(/.*)?$ /treks/
RedirectMatch 301 ^/sitemap\.html$ /
# Blog articles replaced by the High Atlas articles (October 2026).
RedirectMatch 301 ^/blog/(choose-your-morocco-itinerary|first-sahara-desert-tour|best-time-to-visit-morocco|marrakech-to-merzouga-stops|moroccan-culture-food-local-experiences)\.html$ /blog/
RedirectMatch 301 ^/en/blog/(choose-your-morocco-itinerary|first-sahara-desert-tour|best-time-to-visit-morocco|marrakech-to-merzouga-stops|moroccan-culture-food-local-experiences)\.html$ /en/blog/

# Source files are in the repository but are not part of the public website.
RedirectMatch 404 ^/(data|scripts|docs|artifacts|node_modules|\.github|\.claude|\.git)(/|$)
RedirectMatch 404 ^/(readme\.md|package\.json|package-lock\.json|\.gitignore)$

# Original photos stay in the repository only; pages use the resized copies in assets/images/.
# images/uploads/ remains public because CMS uploads are served from there.
RedirectMatch 404 ^/images/(?!uploads/)
